# Copy to .env and fill in what you use. Everything has a working default except the mailbox.

# --- mailbox -----------------------------------------------------------------
# local     directory mailbox under data/mailbox (no account needed; used by `uarb-agent ask`)
# imap      any IMAP/SMTP mailbox, e.g. Gmail with an app password
# agentmail agentmail.to inbox (free tier; inline attachments are capped at 6 MB)
MAIL_TRANSPORT=local
MAIL_ADDRESS=
MAIL_DISPLAY_NAME=UARB Filing Agent
MAIL_POLL_SECONDS=20
# Only answer these senders (comma separated). Empty = answer anyone.
MAIL_ALLOWED_SENDERS=
# Handled mail is moved here (IMAP) so any number of workers can share the inbox.
MAIL_DONE_FOLDER=UARB-Agent-Done
# Reply caps, per hour. Protects against auto-responder loops and floods.
MAIL_MAX_PER_SENDER_HOUR=10
MAIL_MAX_PER_HOUR=60

# imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# agentmail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# --- fetching ------------------------------------------------------------------
UARB_URL=https://uarb.novascotia.ca/fmi/webd/UARB15
UARB_DATA_DIR=data
UARB_MAX_DOCS=10
# Per-email attachment ceiling. Gmail: 25 MB total, so 18 leaves room for base64. AgentMail: use 4.
UARB_ATTACHMENT_MB=18
# Stop downloading for one request once this much has been pulled (hearing audio is large).
UARB_MAX_TOTAL_MB=200
UARB_HEADLESS=1
# Hold a Windows power request while running so a laptop never sleeps under the agent.
UARB_KEEP_AWAKE=1
UARB_NAV_TIMEOUT_S=60
UARB_DOWNLOAD_TIMEOUT_S=180

# --- optional local LLM for messy requests ---------------------------------------
# none | ollama
LLM_BACKEND=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# --- instant trigger (optional): AgentMail webhook -> deploy/relay worker -> GitHub Actions -----
# GITHUB_TOKEN: fine-grained token, Contents read/write on this repo (stored in the worker, not here at runtime)
# RELAY_SECRET: any random string shared between the worker and the AgentMail webhook header
GITHUB_TOKEN=
RELAY_SECRET=
